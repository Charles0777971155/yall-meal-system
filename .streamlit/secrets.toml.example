# Copy this file to .streamlit/secrets.toml and fill in your real values.
# .streamlit/secrets.toml is in .gitignore — never commit it.
#
# On Streamlit Community Cloud, instead of a file, paste these same three
# lines into your app's "Settings -> Secrets" box after deploying.

KOBO_TOKEN = "paste_your_kobo_api_token_here"
KOBO_FORM_UID = "paste_your_kobo_form_uid_here"
KOBO_SERVER = "https://kf.kobotoolbox.org"
